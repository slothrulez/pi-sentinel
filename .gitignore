# Runtime secrets and local configuration (keep only the secret-free example).
.env
.env.*
!.env.example

# Runtime evidence/case data and SQLite databases (never commit collected evidence).
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Key/credential material.
*.pem
*.key
id_rsa*
id_ed25519*

# Python tooling.
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
