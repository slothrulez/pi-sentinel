# PiSentinel M1 configuration example. Contains no secrets; copy to .env (git-ignored) to use.
# Unknown PISENTINEL_* names are rejected so that typos cannot silently fall back to defaults.

# SQLite evidence database file (relative paths resolve against the working directory).
PISENTINEL_DB_PATH=data/cases/pisentinel.sqlite3

# Case/run identifier for the per-case evidence chain. Letters, digits, '.', '_' and '-'; 1-64 chars.
PISENTINEL_CASE_ID=CASE-0001

# DEBUG, INFO, WARNING or ERROR.
PISENTINEL_LOG_LEVEL=INFO

# Maximum canonical evidence record size in bytes (1024-16384).
PISENTINEL_MAX_RECORD_BYTES=16384

# SQLite busy timeout for serialized writers in milliseconds (100-60000).
PISENTINEL_SQLITE_BUSY_TIMEOUT_MS=5000

# Free-space reserve below which health reports storage as degraded (0-10737418240 bytes).
PISENTINEL_MIN_FREE_BYTES=104857600
